# System Manager Environment Configuration
# Optional. Copy to .env beside docker-compose.yml to override the defaults.
# Authentication is enabled unless DISABLE_AUTH is set to 1 here.

# Set to 1 to disable the access code. Development only: the container runs on
# network_mode: host with SYS_ADMIN and NET_ADMIN, so auth off exposes
# POST /api/execute (systemctl and NetworkManager commands) to the whole host.
DISABLE_AUTH=0

# Where the access code file lives. It must be writable by the container.
# Read it with: docker compose exec system-manager cat /data/access-code
# SYSTEM_MANAGER_AUTH_TOKEN_PATH=/data/access-code

# Host root prefix for containerized file reads (set automatically in docker-compose.yml)
# HOST_ROOT=/host
